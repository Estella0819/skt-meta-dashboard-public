# Copy to a local .env file outside version control. Never commit real values.
FB_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Main Shopify store. US official rows may already exist in BigQuery or be imported
# with --shopify-analytics-json when a connected payload is available.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REFRESH_TOKEN=
SNAP_AD_ACCOUNT_IDS=
